pipeline {
    agent any

    tools {
        nodejs "node22" // Buat connection ke Node.js versi 22 sesuai yang didaftarkan di Manage Jenkins > Tools
    
    }

    environment {
        DISCORD_WEBHOOK_URL = credentials('discord-webhook-url') //Buat ambil webhook URL Discord dari Jenkins Credentials
    }

    triggers {
        cron('0 8 * * 1-5') // Trigger tiap jam 8 pagi, Senin-Jumat 
    }

    stages {
        stage('Install Dependencies') {
            steps {
                bat 'npm ci' // untuk install dependencies 
            }
        }

        stage('Run Smoke Tests') {
            environment {
                CYPRESS_apiKey = credentials('reqres-api-key') //Buat ambil APIkey dari Jenkins Credentials
            }
            steps {
                bat 'npm run cy:smoke'
            }
        }
    }

  post {
        always {
            script {
                allure([
                    includeProperties: false,
                    jdk: '',
                    results: [[path: 'allure-results']]
                ])
            }
            script {
                env.BUILD_RESULT_TEXT = currentBuild.currentResult // simpan sebagai env var biar bisa dibaca powershell di bawah
            }
            powershell '''
                $message = "**Smoke Test: $env:BUILD_RESULT_TEXT**`nBuild #$env:BUILD_NUMBER`nAllure Report: $env:BUILD_URL allure`nConsole Log: $env:BUILD_URL console"
                $body = @{ content = $message } | ConvertTo-Json
                Invoke-RestMethod -Uri $env:DISCORD_WEBHOOK_URL -Method Post -ContentType 'application/json' -Body $body
            ''' // Buat kirim message ke Discord
        }
    }
}