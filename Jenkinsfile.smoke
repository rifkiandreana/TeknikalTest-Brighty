pipeline {
    agent any

    tools {
        nodejs "node-22" // nama harus sama persis dengan yang didaftarkan di Manage Jenkins > Tools
    }

    triggers {
        cron('0 8 * * 1-5') // tiap jam 8 pagi, Senin-Jumat (format cron: menit jam tanggal bulan hari)
    }

    stages {
        stage('Install Dependencies') {
            steps {
                bat 'npm ci' // npm ci lebih cepat & konsisten dibanding npm install untuk CI
            }
        }

        stage('Run Smoke Tests') {
            steps {
                bat 'npm run cy:smoke'
            }
        }
    }

    post {
        always {
            script {
                allure([
                    includeProperties: false,
                    jdk: '',
                    results: [[path: 'allure-results']]
                ])
            }
        }
    }
}