pipeline {
    agent any

    tools {
        nodejs "node-22" // nama harus sama persis dengan yang didaftarkan di Manage Jenkins > Tools
    }

    triggers {
        cron('0 1 * * *') // tiap jam 1 pagi, setiap hari
    }

    stages {
        stage('Install Dependencies') {
            steps {
                bat 'npm ci'
            }
        }

        stage('Run Regression Tests') {
            steps {
                bat 'npm run cy:regression'
            }
        }
    }

    post {
        always {
            script {
                allure([
                    includeProperties: false,
                    jdk: '',
                    results: [[path: 'allure-results']]
                ])
            }
        }
    }
}